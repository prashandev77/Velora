# ─────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────
# .env.example — copy this to .env.local and fill in real values
# NEVER commit .env.local to git (it is already in .gitignore)
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Resend (Email) ────────────────────────────────────────────────
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# ── Maintenance mode ──────────────────────────────────────────────
# Set to "true" to show maintenance page to all public visitors.
# Admin panel (/admin) remains accessible. Redeploy after changing.
# NOT prefixed with NEXT_PUBLIC_ so Vercel Edge reads it at runtime.
# MAINTENANCE_MODE=true

# ── Admin session signing (recommended for production) ─────────────
# Random 32+ character string; signs admin idle/absolute timeout cookies
# ADMIN_SESSION_SECRET=

# ── Cloudflare Turnstile (bot protection for public forms) ────────
# https://developers.cloudflare.com/turnstile/
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
