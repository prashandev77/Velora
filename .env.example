# ─────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────
# .env.example — copy this to .env.local and fill in real values
# NEVER commit .env.local to git (it is already in .gitignore)
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Resend (Email) ────────────────────────────────────────────────
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# ── Maintenance page ─────────────────────────────────────────────
# Set to true to show the maintenance screen for all public routes (deploy or restart after changing).
# MAINTENANCE_ALLOW_ADMIN=true (default) keeps /admin and /api/admin/* working so you can manage the site.
# MAINTENANCE_MODE=true
# MAINTENANCE_ALLOW_ADMIN=true
